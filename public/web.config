<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>

    <!-- ═══════════════════════════════════════════════════════════════
         iisnode — routes Node.js requests through IIS
         Requires the iisnode module to be installed on the server.
         Download: https://github.com/tjanczuk/iisnode/releases
    ═══════════════════════════════════════════════════════════════ -->
    <handlers>
      <add name="iisnode" path="server.js" verb="*" modules="iisnode" />
    </handlers>

    <iisnode
      nodeProcessCommandLine="node.exe"
      loggingEnabled="true"
      logDirectory="iisnode"
      debuggingEnabled="false"
      promoteServerVars="HTTP_X_FORWARDED_PROTO,HTTP_X_FORWARDED_FOR"
    />

    <rewrite>
      <rules>
        <!-- 1. Let IIS serve the static files from .next/static directly (CDN-style) -->
        <rule name="Next Static Assets" stopProcessing="true">
          <match url="^_next/static(.*)" />
          <action type="None" />
        </rule>

        <!-- 2. Let IIS serve files from /public directly (images, fonts, etc.) -->
        <rule name="Public Static Files" stopProcessing="true">
          <match url="^(favicon\.ico|robots\.txt|sitemap\.xml|.*\.(png|jpg|jpeg|gif|svg|webp|ico|woff|woff2|ttf|otf|eot|mp4|webm|pdf|css|js|map))$" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" />
          </conditions>
          <action type="None" />
        </rule>

        <!-- 3. Route everything else to the Next.js Node server via iisnode -->
        <rule name="Next.js App" stopProcessing="true">
          <match url=".*" />
          <conditions>
            <add input="{REQUEST_FILENAME}" matchType="IsFile" negate="true" />
          </conditions>
          <action type="Rewrite" url="server.js" />
        </rule>
      </rules>
    </rewrite>

    <staticContent>
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <mimeMap fileExtension=".woff" mimeType="font/woff" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
    </staticContent>

    <httpErrors errorMode="DetailedLocalOnly" existingResponse="PassThrough" />

    <security>
      <requestFiltering>
        <!-- Raise limit for large file uploads if needed -->
        <requestLimits maxAllowedContentLength="52428800" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
